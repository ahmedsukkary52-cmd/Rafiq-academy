<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. The Firebase Emulator Suite speaks plain HTTP and is
     reached through `adb reverse` on the phone's loopback; every other host
     keeps the platform default (no cleartext). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
