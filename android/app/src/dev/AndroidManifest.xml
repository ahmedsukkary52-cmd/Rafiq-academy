<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- LOCAL flavor (Firebase Emulator only). No native [DEFAULT] Firebase
         app: the auto-initializing provider merged from firebase-common is
         removed, so google-services resources are never used to start a
         Firebase app natively. Dart creates the named emulator app itself
         (lib/core/firebase/app_firebase.dart).

         FirebaseMessaging registrars stay registered: the firebase_messaging
         Flutter plugin asks for FirebaseMessaging while Dart creates the
         emulator apps, and fails with NPE if the component is absent (stuck
         native splash). Messaging remains inert in emulator mode — Dart never
         resolves FirebaseMessaging.instance when USE_FIREBASE_EMULATOR=true,
         auto-init is false, and notification delegation is disabled. -->
    <application>
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_notification_delegation_enabled"
            android:value="false" />
    </application>
</manifest>
