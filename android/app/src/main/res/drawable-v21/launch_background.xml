<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 launch screen: brand colour + centred logo (the same
     splash_icon Android 12+ shows via windowSplashScreenAnimatedIcon). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/basma_launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
