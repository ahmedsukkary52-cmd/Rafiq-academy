rules_version = '2';

// Role-aware rules. Interim catch-all (any signed-in user) was replaced so
// Admin-only paths cannot stay world-readable once Auth succeeds.
//
// Helper lookups use users/{uid}.role (Firestore profile), not custom claims.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userRole() {
      return isSignedIn() && exists(userPath())
        ? get(userPath()).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && exists(conversationPath(conversationId))
        && request.auth.uid in get(conversationPath(conversationId)).data.participantIds;
    }

    function isResourceParticipant() {
      return isSignedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    // ── Admin-only academy settings (communication policy, etc.) ───────────
    match /academySettings/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Conversations: participants + silent Admin read oversight ───────────
    // Admin may read every conversation without joining participantIds.
    // Admin-internal group is Admin-only for writes.
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && (isAdmin() || isResourceParticipant());

      allow create: if isSignedIn() && (
        (conversationId == 'admin_internal_group' && isAdmin())
        || (
          request.auth.uid in request.resource.data.participantIds
          && request.resource.data.participantIds.size() <= 2
        )
      );

      allow update: if isSignedIn() && (
        (conversationId == 'admin_internal_group' && isAdmin())
        || isResourceParticipant()
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (isAdmin() || isConversationParticipant(conversationId));

        // Sender must be a real participant — Admin oversight is read-only.
        allow create: if isSignedIn()
          && isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // ── Remaining app collections: signed-in access (pre-hardening parity) ─
    // Full per-role ownership remains a follow-up (B-R1). These matches keep
    // Teacher / Supervisor / Parent / Student working while sensitive paths
    // above are locked.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /studentProfiles/{id} {
      allow read, write: if isSignedIn();
    }
    match /parentProfiles/{id} {
      allow read, write: if isSignedIn();
    }
    match /teacherProfiles/{id} {
      allow read, write: if isSignedIn();
    }
    match /supervisorProfiles/{id} {
      allow read, write: if isSignedIn();
    }
    match /halaqat/{id} {
      allow read, write: if isSignedIn();
    }
    match /reviewSchedules/{id} {
      allow read, write: if isSignedIn();
    }
    match /recitationRecords/{id} {
      allow read, write: if isSignedIn();
    }
    match /attendanceRecords/{id} {
      allow read, write: if isSignedIn();
    }
    match /absenceRequests/{id} {
      allow read, write: if isSignedIn();
    }
    match /achievements/{id} {
      allow read, write: if isSignedIn();
    }
    match /assignments/{id} {
      allow read, write: if isSignedIn();
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }
    match /payments/{id} {
      allow read, write: if isSignedIn();
    }
    match /notifications/{id} {
      allow read, write: if isSignedIn();
    }
    match /complaints/{id} {
      allow read, write: if isSignedIn();
    }
    match /supervisorReports/{id} {
      allow read, write: if isSignedIn();
    }
    match /posts/{id} {
      allow read, write: if isSignedIn();
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }
    match /calendarEvents/{id} {
      allow read, write: if isSignedIn();
    }
    match /contentLibrary/{id} {
      allow read, write: if isSignedIn();
    }
    match /reciters/{id} {
      allow read, write: if isSignedIn();
    }
    match /surahAudios/{id} {
      allow read, write: if isSignedIn();
    }
    match /listeningProgress/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
