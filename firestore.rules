rules_version = '2';

// WA-2 authorization foundation (C1–C4, C10, C16; D1, D2, D14, D16).
// Wired in firebase.json for versioning/emulator — do NOT deploy until
// B-BILLING Verified and the legacy phone data cleanup is complete.
//
// No-personal-phone policy: no client write may add a contact field
// (contactFieldKeys). userPrivate holds only the private email; any doc
// still carrying a legacy contact field is unreadable by every client.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    // A deactivated profile (isActive == false) holds no role: a valid Auth
    // token alone never grants privileges. Missing isActive = legacy active.
    function hasLiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc().get('isActive', true) != false;
    }

    // A newly provisioned Admin holds no role until completeFirstLogin
    // replaces the provisioning password; only the server sets or clears it.
    function hasActiveProfile() {
      return hasLiveProfile()
        && userDoc().get('passwordChangeRequired', false) != true;
    }

    function hasRole(role) {
      return hasActiveProfile() && userDoc().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSupervisor() {
      return hasRole('supervisor');
    }

    function isParent() {
      return hasRole('parent');
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    // Legacy read guard: documents written before the no-phone policy may
    // still carry `phone` until the data cleanup removes it.
    function hasExposedPhone(data) {
      return 'phone' in data
        && data.phone is string
        && data.phone.size() > 0;
    }

    // No-personal-phone policy: mirrors CONTACT_FIELD_KEYS in
    // functions/src/privacy/contactInfoPolicy.ts.
    function contactFieldKeys() {
      return ['phone', 'phoneNumber', 'mobile', 'whatsapp', 'parentPhone', 'guardianPhone'];
    }

    function hasContactField(data) {
      return data.keys().hasAny(contactFieldKeys());
    }

    // Updates may remove a legacy contact field but never add or change one.
    function writesContactField() {
      return request.resource.data.diff(resource.data).addedKeys()
          .hasAny(contactFieldKeys())
        || request.resource.data.diff(resource.data).changedKeys()
          .hasAny(contactFieldKeys());
    }

    function roleUnchanged() {
      return !('role' in request.resource.data)
        || request.resource.data.role == resource.data.role;
    }

    function isActiveUnchanged() {
      return !('isActive' in request.resource.data)
        || request.resource.data.isActive == resource.data.isActive;
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isStaffRole() {
      return isTeacher() || isSupervisor();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── PH-01 relationship helpers (server-side scope, never client claims) ──
    // Roster SSOT is halaqat.studentIds; teacher/supervisor SSOT is
    // halaqat.teacherId / halaqat.supervisorId.
    function halaqaPath(halaqaId) {
      return /databases/$(database)/documents/halaqat/$(halaqaId);
    }

    function halaqaExists(halaqaId) {
      return halaqaId is string
        && halaqaId.size() > 0
        && exists(halaqaPath(halaqaId));
    }

    function halaqaData(halaqaId) {
      return get(halaqaPath(halaqaId)).data;
    }

    // Staff relationship helpers require an active profile: a deactivated
    // teacher/supervisor still named on a halaqa holds no authority there.
    function isTeacherOfHalaqa(halaqaId) {
      return hasActiveProfile()
        && halaqaExists(halaqaId)
        && halaqaData(halaqaId).get('teacherId', '') == uid();
    }

    function isSupervisorOfHalaqa(halaqaId) {
      return hasActiveProfile()
        && halaqaExists(halaqaId)
        && halaqaData(halaqaId).get('supervisorId', '') == uid();
    }

    function isStaffOfHalaqa(halaqaId) {
      return isTeacherOfHalaqa(halaqaId) || isSupervisorOfHalaqa(halaqaId);
    }

    // Admin-activated temporary cover (adminStartHalaqaCover): a teacher or an
    // assigned assistant teacher, only while the cover period is active.
    // Grants record reads for that halaqa; writes stay callable-only.
    function isCoverOfHalaqa(halaqaId) {
      return (isTeacher() || hasRole('assistant_teacher'))
        && halaqaExists(halaqaId)
        && halaqaData(halaqaId).get('coverId', '') != ''
        && halaqaData(halaqaId).get('coverTeacherId', '') == uid();
    }

    function isStudentOnRoster(halaqaId, studentId) {
      return halaqaExists(halaqaId)
        && studentId is string
        && studentId in halaqaData(halaqaId).get('studentIds', []);
    }

    // Caller-side roster access. Deactivation does not remove a student from
    // studentIds, so the roster alone never authorizes a deactivated account.
    function isActiveSelfOnRoster(halaqaId) {
      return hasActiveProfile() && isStudentOnRoster(halaqaId, uid());
    }

    /// D12: linkage comes from parentProfiles.childrenIds (CF/Admin written).
    function isLinkedParentOf(studentId) {
      return isParent()
        && exists(/databases/$(database)/documents/parentProfiles/$(uid()))
        && studentId in get(
          /databases/$(database)/documents/parentProfiles/$(uid())
        ).data.get('childrenIds', []);
    }

    /// C13: roster-derived, CF-maintained staff scope across every halaqa the
    /// student belongs to (covers the second halaqa, unlike the UI pointer).
    function isRosterStaffOf(studentId) {
      return hasActiveProfile()
        && studentId is string
        && exists(/databases/$(database)/documents/studentSearch/$(studentId))
        && uid() in get(
          /databases/$(database)/documents/studentSearch/$(studentId)
        ).data.get('visibleTo', []);
    }

    /// The studentProfiles.halaqaId pointer only selects which halaqa to check;
    /// authority still comes from that halaqa's roster.
    function primaryHalaqaOf(studentId) {
      return exists(/databases/$(database)/documents/studentProfiles/$(studentId))
        ? get(/databases/$(database)/documents/studentProfiles/$(studentId))
            .data.get('halaqaId', '')
        : '';
    }

    function isSupervisorOfStudent(studentId) {
      return isSupervisorOfHalaqa(primaryHalaqaOf(studentId))
        && isStudentOnRoster(primaryHalaqaOf(studentId), studentId);
    }

    function isStaffOfStudentPrimary(studentId) {
      return isStaffOfHalaqa(primaryHalaqaOf(studentId))
        && isStudentOnRoster(primaryHalaqaOf(studentId), studentId);
    }

    /// Operational student records (attendance / evaluations / homework):
    /// Admin, the student, a linked parent, or staff of the record's halaqa
    /// (or roster-derived staff scope for cross-halaqa student views).
    function canReadStudentRecord(data) {
      return isAdmin()
        || (hasActiveProfile() && data.studentId == uid())
        || isStaffOfHalaqa(data.halaqaId)
        || isCoverOfHalaqa(data.halaqaId)
        || isLinkedParentOf(data.studentId)
        || isRosterStaffOf(data.studentId);
    }

    /// P0 messaging/content contract: a Parent belongs to a Halaqa community
    /// when at least one linked child (D12 childrenIds) is on its roster.
    function isLinkedParentOfHalaqa(halaqaId) {
      return isParent()
        && halaqaExists(halaqaId)
        && exists(/databases/$(database)/documents/parentProfiles/$(uid()))
        && get(/databases/$(database)/documents/parentProfiles/$(uid()))
            .data.get('childrenIds', [])
            .hasAny(halaqaData(halaqaId).get('studentIds', []));
    }

    /// Halaqa-scoped community audience (posts, shared content library):
    /// Admin (global oversight), the Halaqa's Teacher/Supervisor, rostered
    /// Students and Parents of rostered Students. Never another Halaqa.
    function canAccessHalaqaCommunity(halaqaId) {
      return isAdmin()
        || isStaffOfHalaqa(halaqaId)
        || isActiveSelfOnRoster(halaqaId)
        || isLinkedParentOfHalaqa(halaqaId);
    }

    // ── users (identity; personal phone numbers are never stored) ──────
    match /users/{userId} {
      // Self stays readable while deactivated: sign-in reads it to show the
      // disabled-account message. Reading another profile needs an active
      // profile. Rules cannot hide single fields, so an active caller can
      // still see another user's email until it leaves this document.
      allow get: if isSelf(userId)
        || isAdmin()
        || (hasActiveProfile() && !hasExposedPhone(resource.data));

      // §16.3: Student/Parent never scan the directory; they may only list
      // Admin contact cards (Parent "contact Admin"). Staff keep roster lists.
      allow list: if isAdmin()
        || (
          hasActiveProfile()
          && !hasExposedPhone(resource.data)
          && (isStaffRole() || resource.data.role == 'admin')
        );

      allow create: if false;
      allow delete: if false;

      allow update: if signedIn() && (
        (
          isSelf(userId)
          && roleUnchanged()
          && isActiveUnchanged()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isActive', 'phone', 'createdAt', 'lifecycle', 'email', 'staffStatus', 'deletedAt', 'passwordChangeRequired', 'academyRef'])
          && !hasExposedPhone(request.resource.data)
          && !writesContactField()
        )
        || (
          // Login state is server-owned for every role: staff through
          // adminSetStaffStatus (refuses while the member holds active
          // halaqat), parents and students through adminSetMemberActive
          // (audited, never an Admin account).
          isAdmin()
          && roleUnchanged()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['email', 'staffStatus', 'deletedAt', 'passwordChangeRequired', 'academyRef', 'lifecycle', 'isActive'])
          && !hasExposedPhone(request.resource.data)
          && !writesContactField()
        )
      );
    }

    // ── Private email (owner / Admin only) ─────────────────────────────
    // Written only server-side (adminProvisionUser, approved migration).
    // No list, so no bulk export. A document still carrying a legacy
    // contact field stays unreadable until the server-side phone cleanup
    // strips that field.
    match /userPrivate/{userId} {
      allow get: if (isAdmin() || (isSelf(userId) && hasLiveProfile()))
        && (resource == null || !hasContactField(resource.data));
      allow list: if false;
      allow write: if false;
    }

    // ── Profiles ───────────────────────────────────────────────────────
    // childrenIds is the D12 relationship graph of minors and their
    // families: only the parent and Admin read it. Staff reach parents
    // through callables (createDirectConversation, getParentChildHalaqat),
    // never by reading or listing family links.
    match /parentProfiles/{parentId} {
      allow read: if isAdmin() || isSelf(parentId);
      allow create, delete: if false;
      allow update: if (isSelf(parentId) || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['childrenIds', 'phone'])
        && !hasExposedPhone(request.resource.data)
        && !writesContactField();
    }

    match /studentProfiles/{studentId} {
      // PH-02 server-owned fields: membership pointer (admitStudentToHalaqa /
      // adminTransferStudent), the coin economy (completeHomework /
      // purchaseAvatar) and award counters (grantAward / completeHomework).
      // No client — not even Admin — writes them directly.
      function serverOwnedProfileFields() {
        return [
          'halaqaId', 'coins', 'unlockedAvatarIds', 'avatarId',
          'lastCompletedHomeworkId', 'points', 'totalStars'
        ];
      }

      // Student A never reads student B unless they share B's primary halaqa
      // roster (group chat display names). Staff read only students they
      // actually serve: the primary halaqa's teacher/supervisor, the
      // roster-derived scope of every halaqa (studentSearch.visibleTo), or
      // the active cover of the primary halaqa. These checks need the
      // document id, so everyone but Admin reads one profile at a time.
      allow list: if isAdmin();
      allow get: if isAdmin()
        || isSelf(studentId)
        || isLinkedParentOf(studentId)
        || isActiveSelfOnRoster(resource.data.get('halaqaId', ''))
        || (isStaffOfHalaqa(resource.data.get('halaqaId', ''))
            && isStudentOnRoster(resource.data.get('halaqaId', ''), studentId))
        || isRosterStaffOf(studentId)
        || (isCoverOfHalaqa(resource.data.get('halaqaId', ''))
            && isStudentOnRoster(resource.data.get('halaqaId', ''), studentId));
      allow create: if false;
      allow delete: if false;
      // D16: never allow phone on profile projections via client writes.
      // C14 / WA-15: `lifecycle` is a privileged operational state. No client
      // may write it — not even Admin — so archive/unarchive can only happen
      // through adminSetStudentLifecycle, which audits every transition.
      allow update: if signedIn()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['phone', 'lifecycle'])
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(serverOwnedProfileFields())
        && !hasExposedPhone(request.resource.data)
        && !writesContactField()
        && isAdmin();
    }

    // C15 / D23 — Mushaf last-read (own R/W; not memorization progress)
    match /mushafReading/{studentId} {
      allow read: if isSelf(studentId) || isAdmin();
      allow create, update: if isSelf(studentId)
        && request.resource.data.keys().hasOnly([
          'surahNumber', 'ayahNumber', 'pageNumber', 'updatedAt', 'visualMode'
        ])
        && request.resource.data.surahNumber is int
        && request.resource.data.ayahNumber is int
        && request.resource.data.pageNumber is int
        && request.resource.data.pageNumber >= 1
        && request.resource.data.pageNumber <= 604;
      allow delete: if false;
    }

    // HR data (weeklyQuota, performanceRating): Admin and the Teacher only.
    // Display names come from users/{uid}, never from this collection.
    match /teacherProfiles/{teacherId} {
      allow read: if isAdmin() || (hasActiveProfile() && isSelf(teacherId));
      allow create: if false;
      allow delete: if false;
      allow update: if signedIn()
        && (
          isAdmin()
          || (
            isSelf(teacherId)
            && !changedKeys().hasAny([
              'performanceRating', 'weeklyQuota', 'halaqatIds'
            ])
          )
        )
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['phone'])
        && !hasExposedPhone(request.resource.data)
        && !writesContactField();
    }

    // Legacy / OUT — quarantine writes (D24)
    match /supervisorProfiles/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Halaqat ────────────────────────────────────────────────────────
    // Roster SSOT (halaqat.studentIds) + staff SSOT (teacherId/supervisorId).
    // PH-02: membership changes only through admitStudentToHalaqa /
    // adminTransferStudent (max-2 cap + duplicate check, transactional).
    // No client — not even Admin — edits studentIds directly.
    // P0-04: creation and schedule slots go through adminCreateHalaqa /
    // adminAddHalaqaSlot (D8 ≥1 slot, D9 conflict engine, teacher lock). No
    // client — not even Admin — creates a Halaqa or edits schedule/teacher.
    match /halaqat/{halaqaId} {
      // J.9: an active profile is required for every role. Admin reads all;
      // otherwise only the assigned Teacher/Supervisor or a rostered Student.
      // Rules cannot hide fields (studentIds, legacy meetingLink), so Parents
      // never read halaqat: getParentChildHalaqat returns name/teacherId/
      // supervisorId of their linked children's Halaqat.
      // Assistant teachers read the halaqat they are assigned to; an active
      // temporary cover reads the halaqa it covers.
      function isScopedReader() {
        return (isTeacher() && resource.data.get('teacherId', '') == uid())
          || (isSupervisor() && resource.data.get('supervisorId', '') == uid())
          || (hasRole('student') && uid() in resource.data.get('studentIds', []))
          || (hasRole('assistant_teacher')
              && uid() in resource.data.get('assistantTeacherIds', []))
          || ((isTeacher() || hasRole('assistant_teacher'))
              && resource.data.get('coverId', '') != ''
              && resource.data.get('coverTeacherId', '') == uid());
      }

      // The meeting link lives only in halaqaMeetingLinks. A document still
      // carrying a legacy link is unreadable except by Admin. Lists cannot
      // prove field absence, so for queries only stripping the legacy key
      // (migrate-meeting-links.mjs --strip-legacy) closes the leak.
      function hasLegacyMeetingLink() {
        return 'meetingLink' in resource.data && resource.data.meetingLink != '';
      }

      allow get: if isAdmin() || (isScopedReader() && !hasLegacyMeetingLink());
      allow list: if isAdmin() || isScopedReader();
      allow create: if false;
      allow delete: if false;
      // Every halaqa field is server-owned, Admin included: the name is
      // bound to the halaqaNameIndex claim taken by adminCreateHalaqa, status
      // drives open-halaqa checks (staff lifecycle, conflicts), and staff,
      // assistant, cover, roster, schedule and meeting link each have their
      // audited callable (adminReassignHalaqaStaff, adminSetHalaqaAssistant,
      // adminStartHalaqaCover / adminEndHalaqaCover, admitStudentToHalaqa,
      // adminAddHalaqaSlot, setHalaqaMeetingLink).
      allow update: if false;
    }

    // Temporary cover periods (active → completed), never deleted.
    match /halaqaCoverPeriods/{coverId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Append-only relationship history written inside each trusted
    // relationship transaction (link, admit, transfer, reassign, assistant,
    // cover).
    match /relationshipHistory/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /academyRefCounters/{kind} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // B14 — canonical meeting link { meetingLink, updatedAt }, written only by
    // setHalaqaMeetingLink / adminCreateHalaqa. Rules cannot hide fields, so
    // access is per document; listing is Admin-only. Teachers and Parents
    // never read the link (see the legacy guard on halaqat).
    match /halaqaMeetingLinks/{halaqaId} {
      function ownStudentProfilePath() {
        return /databases/$(database)/documents/studentProfiles/$(uid());
      }

      // Fails closed against normalizeLifecycle (JS trim + exact 'archived'):
      // any string containing lowercase 'archived' counts as archived, even
      // unusual values the backend would normalize to active. Missing and
      // non-string values stay active.
      function isArchivedLifecycle(profile) {
        return profile.get('lifecycle', null) is string
          && profile.get('lifecycle', null).replace('archived', '')
            != profile.get('lifecycle', null);
      }

      function isEligibleRosterStudent() {
        return hasRole('student')
          && exists(ownStudentProfilePath())
          && !isArchivedLifecycle(get(ownStudentProfilePath()).data)
          && isStudentOnRoster(halaqaId, uid());
      }

      allow get: if isAdmin()
        || (isSupervisor() && isSupervisorOfHalaqa(halaqaId))
        || isEligibleRosterStudent();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // P0-04 — per-teacher schedule serialization locks (CF-only).
    match /halaqaScheduleLocks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // P0-05 — exactly-once homework reward markers (CF-only).
    match /homeworkRewards/{assignmentId} {
      allow read: if isAdmin()
        || (hasActiveProfile() && resource.data.get('studentId', '') == uid());
      allow write: if false;
    }

    // ── Payments ───────────────────────────────────────────────────────
    // C4 / C16 (PH-02): review outcomes, `status=paid`, reviewer identity and
    // review timestamps are written only by the reviewPaymentProof callable
    // (transactional + audited). The current proof pointer, its server-issued
    // `proofCycleId`, the used-name history and `pending_review` are written
    // only by the submitPaymentProof callable after it verified the uploaded
    // Storage object. Clients keep read access and never write payments.
    match /payments/{paymentId} {
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.parentId == uid()
        || (isSupervisor() && isSupervisorOfStudent(resource.data.studentId))
      );
      allow create: if false;
      allow delete: if false;
      allow update: if false;
    }

    // C2 — clients never write paymentAccess; Teacher/Student cannot read.
    // Supervisor scope (parents of supervised students) is not expressible
    // from this doc without a CF-maintained projection → fail closed.
    match /paymentAccess/{parentId} {
      allow read: if isAdmin()
        || (isParent() && parentId == uid());
      allow write: if false;
    }

    // C4 — pricing rules Admin only (Parent never reads overrides)
    match /pricingRules/{ruleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // B10 — minimum-version gate, read before sign-in. Public get of the one
    // document only; no client (Admin included) may list or write it. It is
    // changed only through the deployment procedure (Admin SDK / console).
    match /appConfig/{docId} {
      allow get: if docId == 'clientVersion';
      allow list: if false;
      allow write: if false;
    }

    // C3 — academy settings (WAVE_A: Parent read paymentPublic only; Admin RW)
    // paymentPublic is the Parent-safe projection: only the locked C3 fields
    // may ever be written, so private Admin config cannot leak into it.
    // Vodafone Cash and InstaPay destinations are independent fields; format
    // is validated client-side, the rules bound type and length only.
    match /academySettings/{docId} {
      function optionalBoundedString(data, field, maxLen) {
        return !(field in data)
          || (data[field] is string && data[field].size() <= maxLen);
      }

      allow read: if isAdmin()
        || (docId == 'paymentPublic' && isParent());
      allow write: if isAdmin()
        && (
          docId != 'paymentPublic'
          || (
            request.resource.data.keys().hasOnly([
              'vodafoneCashDestination', 'instapayDestination',
              'updatedAt', 'updatedBy'
            ])
            && optionalBoundedString(
              request.resource.data, 'vodafoneCashDestination', 32)
            && optionalBoundedString(
              request.resource.data, 'instapayDestination', 200)
          )
        );
    }

    // D2 / WA-18 — wallet OUT; deny all client access (Admin SDK bypasses)
    match /wallets/{walletId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /ledger/{entryId} {
        allow read: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // C16 — audit logs (CF/Admin SDK write only; Admin read)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── PH-01 operational collections (C6 / D7 / D10 / D12) ──────────────
    // No collection is signed-in RW any more. Writes are bound to the
    // halaqa's real teacher/supervisor (halaqat SSOT) and to its roster;
    // hard deletes of history are denied except retiring legacy duplicates.

    // Attendance (C6 / PH-02): written only by the recordSessionAttendance
    // callable — real session, roster, halaqa teacher and edit window are
    // checked transactionally there. Clients read; nobody writes directly.
    match /attendanceRecords/{recordId} {
      allow read: if canReadStudentRecord(resource.data);
      allow write: if false;
    }

    // Evaluations. Teacher live evaluations are written only by the
    // upsertSessionEvaluation callable (real session + D7 Present/Late in one
    // transaction). Students still submit homework recitations and the
    // halaqa teacher reviews those pending submissions.
    match /recitationRecords/{recordId} {
      // `{sessionId}_{studentId}_{type}` ids are reserved for live
      // evaluations, and `createdAt` is their server-set edit-window anchor
      // (B1) — a submission can claim neither.
      function studentSubmissionOk() {
        let d = request.resource.data;
        return d.studentId == uid()
          && d.get('reviewStatus', '') == 'pending'
          && isActiveSelfOnRoster(d.halaqaId)
          && !recordId.matches('.*_(memorization|review)$')
          && !d.keys().hasAny(['grade', 'behaviorGrade', 'sessionId', 'createdAt'])
          && !hasContactField(d);
      }

      function teacherReviewOfPendingOk() {
        return isTeacherOfHalaqa(resource.data.halaqaId)
          && resource.data.get('reviewStatus', '') == 'pending'
          && request.resource.data.get('reviewStatus', '') == 'reviewed'
          && changedKeys().hasOnly([
            'reviewStatus', 'grade', 'behaviorGrade', 'notes'
          ]);
      }

      allow read: if canReadStudentRecord(resource.data);
      allow create: if studentSubmissionOk();
      allow update: if teacherReviewOfPendingOk();
      allow delete: if false;
    }

    // استئذان: linked Parent submits for a rostered child; the halaqa's
    // Teacher classifies. Never touches attendance (W7).
    match /absenceRequests/{requestId} {
      function parentRequestOk() {
        let d = request.resource.data;
        return d.requestedBy == uid()
          && isLinkedParentOf(d.studentId)
          && d.status == 'pending'
          && isStudentOnRoster(d.halaqaId, d.studentId)
          && requestId.matches(d.halaqaId + '_' + d.studentId + '_[0-9]{8}')
          && d.keys().hasOnly([
            'studentId', 'halaqaId', 'requestedBy', 'date', 'reason', 'status'
          ]);
      }

      // Missing-doc get: the parent client pre-reads before the first
      // submit. resource is null then, so resource.data checks must not run.
      allow read: if resource == null
        ? isParent()
        : (
          isAdmin()
          || (signedIn() && resource.data.requestedBy == uid())
          || (hasActiveProfile() && resource.data.studentId == uid())
          || isStaffOfHalaqa(resource.data.halaqaId)
          || isLinkedParentOf(resource.data.studentId)
        );
      allow create: if parentRequestOk();
      allow update: if (
          resource.data.get('status', '') == 'pending'
          && resource.data.get('requestedBy', '') == uid()
          && parentRequestOk()
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.halaqaId == resource.data.halaqaId
        )
        || (
          isTeacherOfHalaqa(resource.data.halaqaId)
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.get('reviewedBy', '') == uid()
          && changedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        );
      allow delete: if false;
    }

    // Awards: written only by callables, each keyed by a client operation id
    // so retries replay instead of duplicating — grantAward (credited,
    // totalStars) and issueAchievement (record-only, no credit).
    match /achievements/{achievementId} {
      // get vs list are split on purpose. Parent ownership needs
      // get(parentProfiles), which Firestore cannot prove for list queries, so
      // parent *lists* stay denied while single-doc gets remain allowed.
      function isLinkedParentOfAnyRecipient() {
        return isParent()
          && exists(/databases/$(database)/documents/parentProfiles/$(uid()))
          && resource.data.keys().hasAll(['recipientStudentIds'])
          && resource.data.recipientStudentIds is list
          && get(/databases/$(database)/documents/parentProfiles/$(uid()))
              .data.get('childrenIds', [])
              .hasAny(resource.data.recipientStudentIds);
      }

      // Staff: the grant's primary halaqa, or roster-derived scope of its
      // student. Halaqa award lists for staff go through getHalaqaAwards.
      allow get: if isAdmin()
        || isStaffOfHalaqa(resource.data.get('halaqaId', ''))
        || isRosterStaffOf(resource.data.get('studentId', ''))
        || (hasActiveProfile() && resource.data.get('studentId', '') == uid())
        || (hasActiveProfile()
            && resource.data.keys().hasAll(['recipientStudentIds'])
            && resource.data.recipientStudentIds is list
            && uid() in resource.data.recipientStudentIds)
        || isLinkedParentOf(resource.data.get('studentId', ''))
        || isLinkedParentOfAnyRecipient();

      // Same student/staff constraints as before the parent-get fix — no
      // get(parentProfiles), or student/staff list queries break.
      allow list: if isAdmin()
        || isStaffOfHalaqa(resource.data.get('halaqaId', ''))
        || (hasActiveProfile() && resource.data.get('studentId', '') == uid())
        || (hasActiveProfile() && uid() in resource.data.recipientStudentIds);

      allow create, update, delete: if false;
    }

    // Homework + halaqa activities (assignments SSOT).
    match /assignments/{assignmentId} {
      function assignmentIdentityFrozen() {
        return request.resource.data.get('halaqaId', '') == resource.data.get('halaqaId', '')
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
          && request.resource.data.get('assignedBy', '') == resource.data.get('assignedBy', '');
      }

      function teacherCreateOk() {
        let d = request.resource.data;
        return d.get('assignedBy', '') == uid()
          && isTeacherOfHalaqa(d.get('halaqaId', ''))
          && (
            d.get('studentId', '') == ''
            || isStudentOnRoster(d.halaqaId, d.studentId)
          );
      }

      // Student progress on their own homework (task ticks) and the
      // legacy-shape repair on read. Identity fields stay frozen; completion
      // (`isSubmitted` / `status` / `completedAt`) and its credit belong to
      // the completeHomework callable, and a completed homework is final.
      // P0-05: the reward definition is server-owned (canonical required
      // kinds), so `tasks` edits are evidence only. `kind` may only be set
      // once, on a legacy doc without it, to lesson homework.
      function studentOwnHomeworkUpdate() {
        return hasActiveProfile()
          && resource.data.get('studentId', '') == uid()
          && resource.data.get('status', '') != 'completed'
          && resource.data.get('isSubmitted', false) != true
          && assignmentIdentityFrozen()
          && changedKeys().hasOnly(['tasks', 'title', 'attachments', 'kind'])
          && (
            !changedKeys().hasAny(['kind'])
            || (
              resource.data.get('kind', '') == ''
              && request.resource.data.get('kind', '') == 'lessonHomework'
            )
          );
      }

      // Rostered student refreshing the respondent counter of an activity.
      function studentActivityCounterUpdate() {
        return resource.data.get('studentId', '') == ''
          && isActiveSelfOnRoster(resource.data.get('halaqaId', ''))
          && changedKeys().hasOnly(['responseCount', 'respondentStudentIds'])
          && request.resource.data.get('responseCount', 0) is int
          && uid() in request.resource.data.get('respondentStudentIds', []);
      }

      allow read: if isAdmin()
        || (hasActiveProfile() && resource.data.studentId == uid())
        || isStaffOfHalaqa(resource.data.halaqaId)
        || isActiveSelfOnRoster(resource.data.halaqaId)
        || isLinkedParentOf(resource.data.studentId);
      allow create: if teacherCreateOk()
        && !request.resource.data.keys().hasAny(['completedAt'])
        && !hasContactField(request.resource.data);
      // P0-05: `completedAt` is the server-set legacy reward anchor; no
      // client may set, move or clear it (a reopen can never re-credit).
      allow update: if (
          isTeacherOfHalaqa(resource.data.get('halaqaId', ''))
          && assignmentIdentityFrozen()
          && !changedKeys().hasAny(['completedAt'])
          && !writesContactField()
        )
        || studentOwnHomeworkUpdate()
        || studentActivityCounterUpdate();
      allow delete: if false;

      match /activityResponses/{responseId} {
        function activityHalaqaId() {
          return get(/databases/$(database)/documents/assignments/$(assignmentId))
            .data.get('halaqaId', '');
        }

        allow read: if isAdmin()
          || isStaffOfHalaqa(activityHalaqaId())
          || isActiveSelfOnRoster(activityHalaqaId());
        allow create: if request.resource.data.get('studentId', '') == uid()
          && isActiveSelfOnRoster(activityHalaqaId())
          && !hasContactField(request.resource.data);
        allow update, delete: if false;
      }
    }

    // C11 / WA-13 / PH-02 — in-app cards. Academy fan-out (attendance,
    // homework, activities, evaluations) is CF-authored; recipients come from
    // relationships server-side. The only client create left is the Admin ops
    // broadcast. Server-owned push/deep-link fields cannot be forged.
    match /notifications/{notificationId} {
      function serverOwnedNotificationFields() {
        return ['data', 'delivery', 'push', 'pushedAt', 'deliveredAt'];
      }

      function broadcastAudiences() {
        return ['all', 'admin', 'supervisor', 'teacher', 'parent', 'student'];
      }

      function isNotificationAudience() {
        return signedIn()
          && (
            resource.data.audience in [uid(), 'all']
            || (
              resource.data.audience == userDoc().role
              && userDoc().get('passwordChangeRequired', false) != true
            )
          );
      }

      allow read: if isAdmin() || isNotificationAudience();
      allow create: if isAdmin()
        && !request.resource.data.keys()
            .hasAny(serverOwnedNotificationFields())
        && request.resource.data.get('readBy', []) == []
        && request.resource.data.get('audience', '') in broadcastAudiences()
        && request.resource.data.get('senderId', uid()) == uid()
        && !hasContactField(request.resource.data);
      // Readers may only add themselves to readBy.
      allow update: if isNotificationAudience()
        && changedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.toSet()
            .difference(resource.data.get('readBy', []).toSet())
            .hasOnly([uid()])
        && resource.data.get('readBy', []).toSet()
            .difference(request.resource.data.readBy.toSet()).size() == 0;
      allow delete: if false;
    }

    // Complaints are created and answered only through submitComplaint /
    // respondToComplaint. The complainant reads their own thread; replies
    // and status changes are append-only history entries.
    match /complaints/{complaintId} {
      allow read: if isAdmin()
        || (hasActiveProfile() && resource.data.get('senderId', '') == uid());
      allow create, update, delete: if false;

      match /history/{entryId} {
        allow read: if isAdmin()
          || (hasActiveProfile()
            && get(/databases/$(database)/documents/complaints/$(complaintId))
              .data.get('senderId', '') == uid());
        allow write: if false;
      }
    }

    // CF-only uniqueness locks for normalized halaqa names.
    match /halaqaNameIndex/{key} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // CF-only: academy username → uid, and resumable onboarding progress
    // (no passwords are ever stored in either).
    match /loginUsernames/{username} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /onboardingRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Bulk import ledger (adminImportAcademyRow). Holds no passwords.
    match /importRows/{ref} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /supervisorReports/{reportId} {
      allow read: if isAdmin()
        || (hasActiveProfile() && resource.data.supervisorId == uid());
      allow create: if isSupervisor()
        && request.resource.data.get('supervisorId', '') == uid()
        && !hasContactField(request.resource.data);
      allow update, delete: if false;
    }

    // P0 §7 — posts are Halaqa community announcements, not chat. A post
    // belongs to the Halaqa it was created for (`audienceTarget == halaqaId`);
    // there is no academy-wide feed. Legacy `audienceTarget: 'all'` posts stay
    // readable by Admin only until a product decision re-introduces them.
    match /posts/{postId} {
      function authorCanTarget(d) {
        return d.get('halaqaId', '') is string
          && d.get('halaqaId', '') != ''
          && d.get('audienceTarget', '') == d.get('halaqaId', '')
          && (isAdmin() || isStaffOfHalaqa(d.get('halaqaId', '')));
      }

      // Audience key is `audienceTarget` (the field clients query on; create
      // forces it to equal halaqaId). Legacy 'all' posts resolve to no Halaqa
      // and stay Admin-only.
      function postHalaqaId() {
        return resource.data.get('audienceTarget', '') is string
          ? resource.data.get('audienceTarget', '')
          : '';
      }

      allow read: if isAdmin() || canAccessHalaqaCommunity(postHalaqaId());
      allow create: if signedIn()
        && request.resource.data.get('authorId', '') == uid()
        && authorCanTarget(request.resource.data)
        && !hasContactField(request.resource.data);
      allow update: if canAccessHalaqaCommunity(postHalaqaId())
        && !writesContactField()
        && request.resource.data.get('halaqaId', '') == resource.data.get('halaqaId', '')
        && request.resource.data.get('audienceTarget', '')
            == resource.data.get('audienceTarget', '')
        && (
        // Like / unlike: a reader toggles only their own uid.
        (
          changedKeys().hasOnly(['likedBy'])
          && request.resource.data.likedBy.toSet()
              .difference(resource.data.get('likedBy', []).toSet())
              .union(
                resource.data.get('likedBy', []).toSet()
                  .difference(request.resource.data.likedBy.toSet())
              )
              .hasOnly([uid()])
        )
        // Comment counter: +1 alongside a comment create.
        || (
          changedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount
              == resource.data.get('commentsCount', 0) + 1
        )
        // Pin / edit: author or Admin, authorship frozen.
        || (
          (resource.data.get('authorId', '') == uid() || isAdmin())
          && request.resource.data.get('authorId', '')
              == resource.data.get('authorId', '')
        )
      );
      allow delete: if false;

      match /comments/{commentId} {
        function commentPostHalaqaId() {
          let post = get(/databases/$(database)/documents/posts/$(postId)).data;
          return post.get('audienceTarget', '') is string
            ? post.get('audienceTarget', '')
            : '';
        }

        allow read: if isAdmin() || canAccessHalaqaCommunity(commentPostHalaqaId());
        allow create: if request.resource.data.get('authorId', '') == uid()
          && canAccessHalaqaCommunity(commentPostHalaqaId())
          && !hasContactField(request.resource.data);
        allow update, delete: if false;
      }
    }

    // An event with a halaqaId belongs to that Halaqa's community; an event
    // without one is academy-wide (any active profile) and only Admin
    // creates it. Queries must filter on halaqaId (== id, or == null).
    // list reads resource.data.halaqaId without a default: a defaulted
    // get('halaqaId', null) lets an unfiltered query pass as "general".
    match /calendarEvents/{eventId} {
      function calendarAudience(halaqaId) {
        return hasActiveProfile()
          && (halaqaId == null || canAccessHalaqaCommunity(halaqaId));
      }

      allow get: if isAdmin()
        || calendarAudience(resource.data.get('halaqaId', null));
      allow list: if isAdmin() || calendarAudience(resource.data.halaqaId);
      allow create: if request.resource.data.get('createdBy', '') == uid()
        && !hasContactField(request.resource.data)
        && (isAdmin()
          || (request.resource.data.get('halaqaId', null) is string
            && isStaffOfHalaqa(request.resource.data.halaqaId)));
      allow update: if false;
      allow delete: if isAdmin()
        || (isStaffRole() && resource.data.get('createdBy', '') == uid());
    }

    // P0 §8 — Halaqa shared content library ("Halaqa Details → Shared
    // Content"). Every item belongs to one Halaqa; the Halaqa community reads
    // it, the Halaqa's Teacher/Supervisor and Admin manage it. The file lives
    // under content_library/{halaqaId}/… (Storage rules mirror this scope).
    // Legacy items without a halaqaId are Admin-only.
    match /contentLibrary/{contentId} {
      function contentShapeOk(d) {
        return d.get('halaqaId', '') is string
          && d.get('halaqaId', '') != ''
          && d.get('uploadedBy', '') == uid()
          && d.get('storagePath', '') is string
          && d.get('storagePath', '').matches(
            'content_library/' + d.get('halaqaId', '') + '/' + uid() + '/[^/]+'
          );
      }

      allow read: if isAdmin()
        || canAccessHalaqaCommunity(resource.data.get('halaqaId', ''));
      allow create: if contentShapeOk(request.resource.data)
        && (isAdmin() || isStaffOfHalaqa(request.resource.data.get('halaqaId', '')))
        && !hasContactField(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin()
        || isStaffOfHalaqa(resource.data.get('halaqaId', ''));
    }

    // Reference catalogues: readable, Admin-managed. Public Quran audio
    // catalogue with no personal data, so any signed-in caller may read it.
    match /reciters/{reciterId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /surahAudios/{audioId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /listeningProgress/{progressId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn()
        && request.resource.data.get('userId', '') == uid()
        && !hasContactField(request.resource.data);
      allow update: if signedIn()
        && resource.data.get('userId', '') == uid()
        && request.resource.data.get('userId', '') == uid()
        && !writesContactField();
      allow delete: if false;
    }

    match /reviewSchedules/{scheduleId} {
      allow read: if canReadStudentRecord(resource.data);
      allow write: if isAdmin();
    }

    // Legacy collection name — never an authorization source (WA-12).
    match /halaqaActivity/{id} {
      allow read: if isAdmin();
      allow write: if false;
      match /activityResponses/{responseId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Chat — WA-10 group membership CF-only; WA-11 relationship + soft-delete.
    match /conversations/{conversationId} {
      // No `is list` guard: list queries (array-contains uid) cannot prove it
      // and would be denied; `in` on a non-list already fails closed.
      function isConversationParticipant() {
        return hasActiveProfile()
          && uid() in resource.data.participantIds;
      }

      function canAccessConversation() {
        return isAdmin() || isConversationParticipant();
      }

      // Preview, lastMessage*, membership and other members' counters are
      // written by sendChatMessage / edit / delete / group sync only.
      function onlyResetsOwnUnreadCount() {
        let before = resource.data.get('unreadCounts', {});
        let after = request.resource.data.get('unreadCounts', {});
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCounts'])
          && after is map
          && after.diff(before).affectedKeys().hasOnly([uid()])
          && after.get(uid(), 0) == 0;
      }

      // Participants + Admin monitor (D13). No broad public read.
      allow read: if canAccessConversation();

      // All conversation documents are CF-created (1:1 + halaqa_group).
      allow create: if false;

      allow update: if isConversationParticipant() && onlyResetsOwnUnreadCount();

      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function isMsgConversationParticipant() {
          return hasActiveProfile()
            && parentConversation().participantIds is list
            && uid() in parentConversation().participantIds;
        }

        function canAccessMessages() {
          return isAdmin() || isMsgConversationParticipant();
        }

        allow read: if canAccessMessages();

        // Send / edit / soft-delete go through callables (sendChatMessage,
        // editChatMessage, softDeleteChatMessage). Clients never write here.
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // C6 / WA-8 — sessions SSOT: create via CF only; status updates by
    // Teacher of session or Admin. Identity / snapshot fields immutable.
    match /sessions/{id} {
      function sessionTeacher() {
        return hasActiveProfile()
          && resource.data.teacherId is string
          && resource.data.teacherId == uid();
      }

      function sessionStatusOk() {
        return request.resource.data.status in
          ['scheduled', 'in_progress', 'completed', 'cancelled'];
      }

      // Defense in depth: only status/updatedAt may change; snapshot identity
      // fields (including optional supervisorId) must remain byte-equal.
      function sessionSnapshotFrozen() {
        return request.resource.data.halaqaId == resource.data.halaqaId
          && request.resource.data.slotId == resource.data.slotId
          && request.resource.data.date == resource.data.date
          && request.resource.data.startAt == resource.data.startAt
          && request.resource.data.endAt == resource.data.endAt
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.get('supervisorId', null)
              == resource.data.get('supervisorId', null)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'halaqaId', 'slotId', 'date', 'startAt', 'endAt',
                'teacherId', 'supervisorId', 'createdAt', 'createdBy'
              ]);
      }

      // J.9: no client reads sessions; scoped to the session's Halaqa community.
      allow read: if isAdmin()
        || sessionTeacher()
        || (hasActiveProfile() && canAccessHalaqaCommunity(resource.data.get('halaqaId', '')))
        || isCoverOfHalaqa(resource.data.get('halaqaId', ''));
      allow create: if false;
      allow delete: if false;
      allow update: if signedIn()
        && (isAdmin() || sessionTeacher())
        && sessionStatusOk()
        && sessionSnapshotFrozen()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']);
    }

    // C7 / WA-9 — Cairo-day conflict serialization locks (CF-only).
    match /sessionConflictLocks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // C13 / WA-14 — safe student directory projection. Carries stable ids and
    // display text only; phone/private contact never appears here (D16).
    //
    // Scope is roster-derived: `visibleTo` holds the teacher/supervisor uids of
    // every halaqa whose `studentIds` contains the student. The client-writable
    // `studentProfiles.halaqaId` pointer is NEVER consulted for authorization,
    // so a forged pointer cannot widen who may read a student.
    //
    // Parent and Student have no directory scope (C13.3). A list query must
    // carry `visibleTo array-contains <caller>` or it fails on the first row.
    match /studentSearch/{studentId} {
      allow read: if isAdmin()
        || (signedIn() && uid() in resource.data.get('visibleTo', []));
      allow write: if false;
    }
    // C11 / WA-13 — FCM device tokens: own uid only, never exposed to others.
    // Admin/service access goes through the Admin SDK (trusted CF), not Rules.
    match /fcmTokens/{userId} {
      function deviceClientFields() {
        return ['token', 'platform', 'createdAt', 'updatedAt', 'disabled'];
      }

      // Reads through get() defaults — a missing field must fail closed
      // without raising an evaluation error.
      function deviceShapeValid() {
        return request.resource.data.get('token', '') is string
          && request.resource.data.get('token', '').size() > 0
          && request.resource.data.get('token', '').size() <= 4096
          && request.resource.data.get('platform', '')
              in ['android', 'ios', 'web']
          && request.resource.data.get('disabled', '') is bool;
      }

      allow read: if isSelf(userId);
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if isSelf(userId);

        allow create: if isSelf(userId)
          && request.resource.data.keys().hasOnly(deviceClientFields())
          && request.resource.data.keys()
              .hasAll(['token', 'platform', 'disabled'])
          && deviceShapeValid();

        // Server-owned fields (disabledReason/disabledAt/lastSendAt/
        // lastErrorCode) stay unwritable by the client.
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(deviceClientFields())
          && deviceShapeValid();

        allow delete: if isSelf(userId);
      }
    }

    // C11 / WA-13 — send-state claims (CF-only; proof a push was authorized).
    match /notificationDeliveries/{notificationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny — no catch-all signed-in RW
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
