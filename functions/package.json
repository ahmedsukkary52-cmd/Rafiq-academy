{
  "name": "functions",
  "description": "Cloud Functions - رفيق أكاديمية تحفيظ القرآن",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:unit": "node --test test/wa1_provision_gate.test.mjs",
    "test:wa13": "node --test test/wa13_fcm_send_chain.test.mjs",
    "test:wa14": "node --test test/wa14_student_search.test.mjs"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7"
  },
  "private": true
}