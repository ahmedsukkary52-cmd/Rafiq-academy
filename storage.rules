rules_version = '2';

// Firebase Storage rules for Rafiq Academy payment proofs.
// Path: payment_proofs/{parentId}/{paymentId}/{fileName}
//
// Parent uploads own proofs. Authenticated academy staff (supervisor/admin)
// may read for review. Full role claims hardening remains Category B.

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isParentOwner(parentId) {
      return isSignedIn() && request.auth.uid == parentId;
    }

    match /payment_proofs/{parentId}/{paymentId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isParentOwner(parentId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}
